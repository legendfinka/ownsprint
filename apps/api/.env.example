NODE_ENV=development
PORT=4000
# Matches docker-compose.yml
DATABASE_URL=postgresql://ownsprint:ownsprint@localhost:5432/ownsprint

# At least 32 characters. Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-replace-me-with-a-long-random-value
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX=10
# Proxies in front of the API (0 locally; 2 on Render behind Vercel)
TRUST_PROXY=0

# AI: who answers the "Suggest estimate" and "Break down" buttons.
#
#   mock       Default. Fixed sample answers: free, no setup, works offline.
#
#   ollama     A free model running on your own computer (https://ollama.com).
#              1. brew install ollama        (or download it from ollama.com)
#              2. ollama pull qwen2.5:7b     (~4.7 GB; use qwen2.5:3b with 8 GB RAM)
#              3. Start it: `ollama serve` (keep that terminal open), or
#                 `brew services start ollama` to run it in the background.
#                 (The ollama.com download is a menu-bar app: just open it.)
#              4. Set AI_PROVIDER=ollama and restart `pnpm dev`.
#
#   anthropic  Claude via the Anthropic API: best answers, paid per use.
#              1. Create a key at https://console.anthropic.com (set a spend limit)
#              2. Put it in ANTHROPIC_API_KEY below and restart `pnpm dev`.
#
# The API prints the provider it uses at startup ("AI provider: ...").
AI_PROVIDER=mock
# Empty: claude-haiku-5-5 (anthropic) or qwen2.5:7b (ollama)
AI_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
# AI calls per user per hour
AI_RATE_LIMIT_MAX=20
