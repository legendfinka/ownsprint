generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum values must stay in sync with packages/shared/src/enums.ts.

enum Role {
  owner
  member
}

enum SprintStatus {
  planned
  active
  completed
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum Priority {
  low
  medium
  high
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String   @default("")
  avatarColor  String?
  avatarEmoji  String?
  createdAt    DateTime @default(now())

  ownedProjects Project[]      @relation("ProjectOwner")
  memberships   Membership[]
  assignedTasks Task[]         @relation("TaskAssignee")
  refreshTokens RefreshToken[]
}

model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())

  // Restrict: a user who still owns projects cannot be deleted by accident.
  owner       User         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships Membership[]
  sprints     Sprint[]
  tasks       Task[]

  @@index([ownerId])
}

model Membership {
  userId    String @db.Uuid
  projectId String @db.Uuid
  role      Role   @default(member)
  // What the person does on the team ("Developer", "Tester"…). A label only:
  // permissions come from `role`.
  title     String? @db.VarChar(40)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The composite primary key enforces one membership per user per project
  // and covers lookups by userId. The extra index covers "members of a project".
  @@id([userId, projectId])
  @@index([projectId])
}

model Sprint {
  id        String       @id @default(uuid(7)) @db.Uuid
  projectId String       @db.Uuid
  name      String
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    SprintStatus @default(planned)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
}

model Task {
  id          String     @id @default(uuid(7)) @db.Uuid
  projectId   String     @db.Uuid
  sprintId    String?    @db.Uuid
  parentId    String?    @db.Uuid
  title       String
  description String     @default("")
  status      TaskStatus @default(todo)
  priority    Priority   @default(medium)
  estimate    Int?
  assigneeId  String?    @db.Uuid
  // Fractional ordering inside a column: a moved card gets the midpoint of its
  // new neighbours, so a reorder updates a single row.
  position    Float
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting a sprint moves its tasks back to the backlog.
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([sprintId, status, position])
  @@index([assigneeId])
  @@index([parentId])
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  // SHA-256 of the raw token; the raw value only ever lives in the cookie.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
